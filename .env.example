# OpenRouter API Key (https://openrouter.ai/keys)
NEXT_PUBLIC_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Market Data Provider Keys
POLYGON_API_KEY=your_polygon_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
TIINGO_API_KEY=your_tiingo_api_key_here

# IBKR Gateway (CME futures). Set on the SCANNER/server process only — the
# headless IB Gateway must be reachable at this host:port (see
# docker-compose.ibkr.yml). When IBKR_GATEWAY_HOST is set, futures route
# IBKR -> Yahoo automatically. Historical bars need no real-time
# market-data subscription. Leave unset in the web app.
# IBKR_GATEWAY_HOST=127.0.0.1
# IBKR_GATEWAY_PORT=4001
# IBKR_CLIENT_ID=7

# Shared scanner cadence governor. These defaults match Tiingo Power's published
# quotas while reserving 20% for retries, manual requests, and payload variance.
SCANNER_GOVERNOR=true
SCANNER_BUDGET_HOURLY=10000
SCANNER_BUDGET_DAILY=100000
SCANNER_BUDGET_MONTHLY_BYTES=40000000000
SCANNER_BUDGET_HEADROOM=0.8
SCANNER_BUDGET_FLOOR_SECONDS=15
SCANNER_ESTIMATED_BYTES_PER_BAR=110
# Optional per-provider-scope overrides as JSON, e.g. a redistribution plan:
# SCANNER_PROVIDER_BUDGETS={"tiingo:server":{"hourlyCap":80000,"dailyCap":1200000,"monthlyBandwidthBytes":1000000000000}}

# Database Configuration
POSTGRES_PASSWORD=your_postgres_password_here
DATABASE_URL=postgresql://tradingdiary:your_postgres_password_here@127.0.0.1:25432/tradingdiary

# Better Auth & Google OAuth Credentials
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# React Engage Suite Email Configuration
ENGAGE_API_KEY=your_brevo_api_key_here
ENGAGE_ADMIN_EMAIL=hello@tradingdiary.app
ENGAGE_FROM_NAME="Trading Diary Support"
ENGAGE_FROM_EMAIL=hello@tradingdiary.app
