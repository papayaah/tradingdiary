# Copy to .env.ibkr.primary and fill in your PRIMARY account holder's login
# (the one that HAS the real-time futures subscription, e.g. mickey825).
# .env.ibkr.primary is gitignored — never commit real creds.
#
#   cp .env.ibkr.primary.example .env.ibkr.primary

IBKR_USER=your_primary_username
IBKR_PASSWORD=your_primary_password
TRADING_MODE=live
VNC_PASSWORD=changeme
