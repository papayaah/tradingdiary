# Copy to .env.ibkr and fill in. .env.ibkr is gitignored — never commit real creds.
#
#   cp .env.ibkr.example .env.ibkr
#
# For the first smoke test use your PAPER trading login (TRADING_MODE=paper).
# Paper has no CME data fee and won't collide with a live TWS session.

IBKR_USER=your_paper_username
IBKR_PASSWORD=your_paper_password

# paper | live  — keep this as paper for the smoke test
TRADING_MODE=paper

# Any password you choose; needed to open a VNC viewer to watch the Gateway GUI.
VNC_PASSWORD=changeme
