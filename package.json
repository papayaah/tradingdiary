    "@types/papaparse": "^5.5.2",
    "ai": "^6.0.108",
    "better-auth": "^1.5.4",
    "bullmq": "^5.81.2",
    "cropperjs": "^2.1.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "idb": "^8.0.3",
    "ioredis": "^5.11.1",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "papaparse": "^5.5.3",
    "postgres": "^3.4.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
