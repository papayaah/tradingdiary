{
  "name": "tradingdiary",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "video:studio": "npx -p @remotion/cli@4.0.500 remotion studio",
    "video:render:consecutive": "npx -p @remotion/cli@4.0.500 remotion render ConsecutiveMove marketing/videos/output/consecutive-pattern-promo.mp4",
    "video:gif:consecutive": "npx -p @remotion/cli@4.0.500 remotion render ConsecutiveMove marketing/videos/output/consecutive-pattern-promo.gif --codec=gif --scale=0.5",
    "video:render:ibkr": "npx -p @remotion/cli@4.0.500 remotion render IBKRGuidePromo marketing/videos/output/ibkr-tradelog-tutorial.mp4",
    "video:gif:ibkr": "npx -p @remotion/cli@4.0.500 remotion render IBKRGuidePromo marketing/videos/output/ibkr-tradelog-tutorial.gif --codec=gif --scale=0.5",
    "video:render:ibkr-flex": "npx -p @remotion/cli@4.0.500 remotion render IBKRFlexGuidePromo marketing/videos/output/ibkr-flex-tutorial.mp4",
    "video:render:import": "npx -p @remotion/cli@4.0.500 remotion render ImportPromo marketing/videos/output/import-promo.mp4",
    "video:gif:import": "npx -p @remotion/cli@4.0.500 remotion render ImportPromo marketing/videos/output/import-promo.gif --codec=gif --scale=0.5",
    "video:render:replay": "npx -p @remotion/cli@4.0.500 remotion render ReplayPromo marketing/videos/output/replay-promo.mp4",
    "video:gif:replay": "npx -p @remotion/cli@4.0.500 remotion render ReplayPromo marketing/videos/output/replay-promo.gif --codec=gif --scale=0.5",
    "video:render:consecutive:light": "npx -p @remotion/cli@4.0.500 remotion render ConsecutiveMoveLight marketing/videos/output/consecutive-pattern-promo-light.mp4",
    "video:render:import:light": "npx -p @remotion/cli@4.0.500 remotion render ImportPromoLight marketing/videos/output/import-promo-light.mp4",
    "video:render:replay:light": "npx -p @remotion/cli@4.0.500 remotion render ReplayPromoLight marketing/videos/output/replay-promo-light.mp4",
    "video:render:analytics:light": "npx -p @remotion/cli@4.0.500 remotion render AnalyticsPromoLight marketing/videos/output/analytics-promo-light.mp4",
    "video:render:mashup:light": "npx -p @remotion/cli@4.0.500 remotion render ProductMashupPromoLight marketing/videos/output/trading-diary-demo-light.mp4",
    "video:render:analytics": "npx -p @remotion/cli@4.0.500 remotion render AnalyticsPromo marketing/videos/output/analytics-promo.mp4",
    "video:gif:analytics": "npx -p @remotion/cli@4.0.500 remotion render AnalyticsPromo marketing/videos/output/analytics-promo.gif --codec=gif --scale=0.5",
    "video:render:mashup": "npx -p @remotion/cli@4.0.500 remotion render ProductMashupPromo marketing/videos/output/trading-diary-demo.mp4",
    "video:render:autoscan": "npx -p @remotion/cli@4.0.500 remotion render AutoScanPromo marketing/videos/output/auto-scan-promo.mp4",
    "video:render:autoscan:light": "npx -p @remotion/cli@4.0.500 remotion render AutoScanPromoLight marketing/videos/output/auto-scan-promo-light.mp4",
    "video:render:pattern": "npx -p @remotion/cli@4.0.500 remotion render PatternPromoMain marketing/videos/output/pattern-promo.mp4",
    "video:render:pattern:light": "npx -p @remotion/cli@4.0.500 remotion render PatternPromoMainLight marketing/videos/output/pattern-promo-light.mp4",
    "meta:generate": "node scripts/generate-meta-screenshot.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:schema:push": "drizzle-kit push",
    "db:schema:pull": "drizzle-kit pull",
    "db:pull": "bash scripts/db-pull.sh",
    "db:seed": "tsx scripts/seed-watches.ts",
    "scanner": "tsx lib/scanner/main.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.53",
    "@ai-sdk/google": "^3.0.36",
    "@ai-sdk/openai": "^3.0.39",
    "@reactkits.dev/better-auth-connect": "file:packages/better-auth-connect",
    "@reactkits.dev/react-engage": "file:packages/react-engage",
    "@stoqey/ib": "^1.6.5",
    "@types/papaparse": "^5.5.2",
    "ai": "^6.0.108",
    "better-auth": "^1.5.4",
    "bullmq": "^5.81.2",
    "cropperjs": "^2.1.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.3",
    "ioredis": "^5.11.1",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "papaparse": "^5.5.3",
    "postgres": "^3.4.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "^15.0.0",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.500",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "remotion": "^4.0.500",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
