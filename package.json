{
  "name": "tradingdiary",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "video:studio": "remotion studio",
    "video:render:consecutive": "remotion render ConsecutiveMove marketing/videos/output/consecutive-pattern-promo.mp4",
